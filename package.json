{
  "name": "est-o-auth",
  "version": "2.0.0",
  "private": true,
  "description": "Use Estonian ID-card, Mobile-ID, Smart-ID or E-mail as OAuth authentication provider",
  "author": "Argo Roots <argo@roots.ee>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "lint": "eslint . --fix --config .config/eslint.config.ts",
    "dev": "nuxt dev",
    "dev:ssl": "nuxt dev --https --ssl-cert .certs/localhost.crt --ssl-key .certs/localhost.key",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "cleanup": "nuxt cleanup"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1125.0",
    "@aws-sdk/client-ses": "3.1125.0",
    "@aws-sdk/client-sns": "3.1125.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxtjs/i18n": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@web-eid/web-eid-library": "2.1.0",
    "bcrypt": "6.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-tailwindcss": "4.4.0",
    "jsonwebtoken": "9.0.3",
    "nuxt": "4.5.2",
    "qrcode": "1.5.4",
    "stripe": "22.6.1",
    "tailwindcss": "4.3.3"
  }
}
